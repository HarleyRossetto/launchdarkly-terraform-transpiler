{
  "resource": {
    "launchdarkly_project": {
      "my-project": {
        "key": "my-project",
        "name": "My Project",
        "tags": null,
        "environments": {
          "dev": {
            "key": "dev",
            "name": "Development",
            "color": "0000FF"
          },
          "test": {
            "key": "test",
            "name": "Test",
            "color": "00FF00"
          },
          "prod": {
            "key": "prod",
            "name": "Production",
            "color": "FF0000",
            "approval_settings": {
              "auto_apply_approved_changes": false,
              "min_num_approvals": 1,
              "service_kind": "launchdarkly"
            }
          },
          "prod2": {
            "key": "prod2",
            "name": "Production2",
            "color": "FF0000",
            "approval_settings": {
              "auto_apply_approved_changes": false,
              "min_num_approvals": 2,
              "required_approval_tags": [
                "compliance",
                "security"
              ],
              "service_kind": "launchdarkly"
            }
          }
        },
        "lifecycle": {
          "ignore_changes": [
            "environments"
          ]
        }
      }
    },
    "launchdarkly_environment": {
      "my-project-dev": {
        "key": "dev",
        "name": "Development",
        "color": "0000FF",
        "project_key": "${launchdarkly_project.my-project.key}"
      },
      "my-project-test": {
        "key": "test",
        "name": "Test",
        "color": "00FF00",
        "project_key": "${launchdarkly_project.my-project.key}"
      },
      "my-project-prod": {
        "key": "prod",
        "name": "Production",
        "color": "FF0000",
        "approval_settings": {
          "auto_apply_approved_changes": false,
          "min_num_approvals": 1,
          "service_kind": "launchdarkly"
        },
        "segment_approval_settings": {
          "auto_apply_approved_changes": false,
          "min_num_approvals": 1,
          "service_kind": "launchdarkly"
        },
        "project_key": "${launchdarkly_project.my-project.key}"
      },
      "my-project-prod2": {
        "key": "prod2",
        "name": "Production2",
        "color": "FF0000",
        "approval_settings": {
          "auto_apply_approved_changes": false,
          "min_num_approvals": 2,
          "required_approval_tags": [
            "compliance",
            "security"
          ],
          "service_kind": "launchdarkly"
        },
        "segment_approval_settings": {
          "auto_apply_approved_changes": false,
          "min_num_approvals": 2,
          "required_approval_tags": [
            "compliance",
            "security",
            "hxr"
          ],
          "service_kind": "launchdarkly"
        },
        "project_key": "${launchdarkly_project.my-project.key}"
      }
    }
  }
}