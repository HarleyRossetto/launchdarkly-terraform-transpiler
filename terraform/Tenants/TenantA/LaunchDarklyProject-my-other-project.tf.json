      },
      "my-other-project-prod": {
        "key": "prod",
        "name": "Production",
        "color": "FF0000",
        "approval_settings": {
          "auto_apply_approved_changes": false,
          "min_num_approvals": 1,
          "service_kind": "launchdarkly"
        },
        "segment_approval_settings": {
          "auto_apply_approved_changes": false,
          "min_num_approvals": 1,
          "service_kind": "launchdarkly"
        },
        "project_key": "${launchdarkly_project.my-other-project.key}"
      }
    }
  }
}