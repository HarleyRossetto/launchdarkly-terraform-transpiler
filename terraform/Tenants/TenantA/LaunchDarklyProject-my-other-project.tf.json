{
  "resource": {
    "launchdarkly_project": {
      "my-other-project": {
        "key": "my-other-project",
        "name": "My Other Project",
        "tags": null,
        "environments": {
          "dev": {
            "key": "dev",
            "name": "Development",
            "color": "0000FF"
          },
          "prod": {
            "key": "prod",
            "name": "Production",
            "color": "FF0000",
            "approval_settings": {
              "auto_apply_approved_changes": false,
              "min_num_approvals": 1,
              "service_kind": "launchdarkly"
            }
          }
